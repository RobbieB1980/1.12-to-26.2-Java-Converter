<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RB-112-to-262-Java-Converter-Setup</AssemblyName>
    <RootNamespace>RB.JavaConverter112.Setup</RootNamespace>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <Product>RB 1.12 to 26.2 Java Converter Setup</Product>
    <Company>RobbieB1980</Company>
    <Version>0.8.0</Version>
    <FileVersion>0.8.0</FileVersion>
    <InformationalVersion>0.8.0</InformationalVersion>
    <Description>Installer for RB 1.12 to 26.2 Java Converter (portable toolset)</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\dist\portable-payload.zip"
                      Condition="Exists('..\..\dist\portable-payload.zip')"
                      LogicalName="portable-payload.zip" />
  </ItemGroup>

</Project>
